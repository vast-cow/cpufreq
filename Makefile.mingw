# Build from an MSYS2 UCRT64 shell:
#   mingw32-make -f Makefile.mingw

CC      = gcc
TARGET  := cpufreq.exe
OBJECTS := main.o

CPPFLAGS ?=
CPPFLAGS += -D_WIN32_WINNT=0x0602 -include mingw_compat.h
CFLAGS   ?= -O2
CFLAGS   += -std=c11 -Wall -Wextra -Wpedantic
LDFLAGS  ?=
LDLIBS   := -lpowrprof

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)

main.o: main.c mingw_compat.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

clean:
	$(RM) $(TARGET) $(OBJECTS)
